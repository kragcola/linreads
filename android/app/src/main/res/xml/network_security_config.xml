<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is needed for user-configured LAN and Tailscale Calibre servers on Android 9+.
  Network Security Config cannot express private CIDR ranges or runtime MagicDNS hosts,
  so runtime URL/origin policies must guard every source client before it sends a request.
  Do NOT hardcode a real baseUrl (C2).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
